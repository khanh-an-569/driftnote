# Copy to .env. Keep .env local and never commit real secrets.
# Prefer a skill-specific vault when different skills may target different vaults.
WEB_TO_OBSIDIAN_VAULT_PATH=D:/Notes/Web Sources
# Optional compatibility fallback for skills that do not define a dedicated vault.
OBSIDIAN_VAULT_PATH=D:/Notes/Second Brain
TAVILY_API_KEY=
