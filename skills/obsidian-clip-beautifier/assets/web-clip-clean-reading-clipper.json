{
  "schemaVersion": "0.1.0",
  "name": "Web Clip - Clean Reading",
  "behavior": "create",
  "noteContentFormat": "# {{title}}\n\n> [!info] Source\n> [Open original]({{url}})\n\n---\n\n{{content}}",
  "properties": [
    {
      "name": "type",
      "value": "web-clip",
      "type": "text"
    },
    {
      "name": "status",
      "value": "inbox",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author|split:\", \"|wikilink|join}}",
      "type": "multitext"
    },
    {
      "name": "published",
      "value": "{{published}}",
      "type": "date"
    },
    {
      "name": "clipped_at",
      "value": "{{date}}",
      "type": "datetime"
    },
    {
      "name": "tags",
      "value": "source/web",
      "type": "multitext"
    },
    {
      "name": "cssclasses",
      "value": "web-clip",
      "type": "multitext"
    }
  ],
  "triggers": [],
  "noteNameFormat": "{{title}}",
  "path": "00 Inbox/Web"
}
